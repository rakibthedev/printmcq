<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MCQ Printable A4</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@400;600;700&display=swap" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

<style>
    /* RESET & BASICS */
    * { box-sizing: border-box; }
    
    body { 
        font-family: 'Noto Serif Bengali', serif; 
        font-size: 14px; 
        margin: 0; 
        background: #525659; /* Document viewer dark grey */
        height: 100vh;
        overflow: hidden; /* Hide body scroll, let content scroll */
    }

    /* --- SIDEBAR STYLE --- */
    #sidebar {
        width: 220px;
        background: #f8f9fa;
        padding: 15px;
        border-right: 1px solid #ccc;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        overflow-y: auto;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    #sidebar h3 { margin-top: 0; text-align: center; color: #333; }

    .json-btn {
        width: 100%;
        margin: 5px 0;
        padding: 10px;
        background: #e9ecef;
        border: 1px solid #ced4da;
        cursor: pointer;
        font-size: 15px;
        border-radius: 4px;
        text-align: left;
        transition: all 0.2s;
        font-family: inherit;
    }

    .json-btn:hover { background: #dee2e6; }
    .json-btn.active { background: #6a1b9a; color: #fff; border-color: #6a1b9a; }

    /* --- MAIN VIEWPORT --- */
    #content {
        margin-left: 220px; /* Offset for sidebar */
        height: 100vh;
        width: calc(100% - 220px);
        overflow: auto; /* ENABLE SCROLLING FOR THE A4 SHEET */
        padding: 30px; /* Space around the paper */
        display: flex;
        justify-content: center; /* Center paper horizontally */
        align-items: flex-start;
    }

    /* --- THE A4 PAPER --- */
    .a4-sheet {
        /* FIXED A4 DIMENSIONS */
        width: 210mm;
        min-height: 297mm; /* Min height for A4 */
        
        /* VISUALS */
        background: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        
        /* MARGINS AS REQUESTED */
        padding: 20px; 
        
        /* LAYOUT */
        display: flex;
        flex-direction: column;
        
        /* Prevent shrinking */
        flex-shrink: 0; 
    }

    /* HEADER */
    #header-section {
        width: 100%;
        text-align: center;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #aaa;
    }
    .main-header { font-size: 20px; font-weight: 700; line-height: 1.4; }

    /* MCQ COLUMNS */
    #mcq-container {
        column-count: 3;
        column-gap: 20px;
        column-fill: balance;
        height: 100%;
    }

    .mcq {
        break-inside: avoid; /* Don't split a question across columns */
        margin-bottom: 12px;
        page-break-inside: avoid;
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 3px;
    }

    .question-text { flex: 1; font-weight: 600; padding-right: 5px; }

    .answer {
        font-weight: bold;
        font-size: 11px;
        min-width: 18px;
        height: 18px;
        border: 1px solid #000;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 2px;
    }

    .options {
        display: grid;
        grid-template-columns: 1fr 1fr; /* 2 options per row */
        column-gap: 5px;
        font-size: 13px;
        line-height: 1.3;
    }

    img, math { max-width: 100%; }

    /* UI BUTTONS */
    #sidebar-toggle {
        display: none;
        position: fixed;
        top: 15px;
        left: 15px;
        z-index: 1100;
        padding: 8px 12px;
        background: #333;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    #printBtn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #d32f2f;
        color: #fff;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        z-index: 999;
        font-size: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* --- RESPONSIVE / MOBILE --- */
    @media (max-width: 900px) {
        #sidebar {
            transform: translateX(-100%);
        }
        #sidebar.show {
            transform: translateX(0);
            box-shadow: 2px 0 10px rgba(0,0,0,0.2);
        }
        #content {
            margin-left: 0;
            width: 100%;
            padding: 10px; /* Less grey space on mobile */
            justify-content: flex-start; /* Align left to make scrolling natural */
        }
        #sidebar-toggle { display: block; }
        
        /* Note: We DO NOT change .a4-sheet width. 
           It stays 210mm, forcing horizontal scroll on small screens */
    }

    /* --- PRINT SETTINGS --- */
    @media print {
        @page { 
            size: A4; 
            margin: 0; /* Browser margin 0, we use padding */
        }
        body { 
            background: #fff; 
            height: auto; 
            overflow: visible;
        }
        #sidebar, #printBtn, #sidebar-toggle { display: none !important; }
        
        #content {
            margin: 0;
            padding: 0;
            width: 100%;
            height: auto;
            overflow: visible;
            display: block;
        }

        .a4-sheet {
            width: 100%; /* Fill print page */
            height: auto;
            min-height: auto;
            box-shadow: none;
            margin: 0;
            padding: 20px; /* The 20px margin requested */
        }
        
        #mcq-container {
             /* Fix column break issues in print preview */
            column-fill: auto;
        }
    }
</style>
</head>
<body>

<button id="sidebar-toggle" onclick="toggleSidebar()">☰</button>

<div id="sidebar">
    <h3>Question Bank</h3>
    </div>

<div id="content">
    
    <div class="a4-sheet">
        <div id="header-section"></div>
        <div id="mcq-container"></div>
    </div>

</div>

<button id="printBtn" onclick="window.print()">Print</button>

<script>
    // --- YOUR DATA CONFIG ---
    const jsonMap = {
        "All Bcs": "json/bcs_all.json",
        "Bangla": "json/bangla.json"
    };
    // ------------------------

    const sidebar = document.getElementById('sidebar');
    const container = document.getElementById('sidebar'); // Appending directly to sidebar
    let activeButton = null;

    // 1. Generate Sidebar
    Object.keys(jsonMap).forEach(key => {
        const btn = document.createElement('button');
        btn.className = 'json-btn';
        btn.textContent = key;
        btn.addEventListener('click', () => {
            loadJSON(jsonMap[key]);
            setActiveButton(btn);
            // On mobile, close sidebar after selection
            if (window.innerWidth <= 900) sidebar.classList.remove('show');
        });
        container.appendChild(btn);
    });

    function setActiveButton(btn) {
        if (activeButton) activeButton.classList.remove('active');
        btn.classList.add('active');
        activeButton = btn;
    }

    function toggleSidebar() {
        sidebar.classList.toggle('show');
    }

    function renderMCQ(data) {
        const headerContainer = document.getElementById('header-section');
        const mcqContainer = document.getElementById('mcq-container');
        const letters = ['a','b','c','d','e','f'];

        // Clear previous
        headerContainer.innerHTML = "";
        mcqContainer.innerHTML = "";

        // Header
        if (data.length > 0 && data[0].header) {
            data[0].header.forEach(text => {
                if (text.trim() !== "") {
                    const div = document.createElement('div');
                    div.className = 'main-header';
                    div.textContent = text;
                    headerContainer.appendChild(div);
                }
            });
        }

        // Questions
        for (let i = 1; i < data.length; i++) {
            const item = data[i];
            const mcq = document.createElement('div');
            mcq.className = 'mcq';

            // Top Row: Question + Answer Bubble
            const labelRow = document.createElement('div');
            labelRow.className = 'label-row';

            const qText = document.createElement('div');
            qText.className = 'question-text';
            qText.innerHTML = `${i}. ${item.label}`;

            const ans = document.createElement('div');
            ans.className = 'answer';
            ans.textContent = (item.answer || "").toUpperCase();

            labelRow.appendChild(qText);
            labelRow.appendChild(ans);
            mcq.appendChild(labelRow);

            // Options Grid
            if(item.options && item.options.length > 0){
                const opts = document.createElement('div');
                opts.className = 'options';

                item.options.forEach((op, idx) => {
                    const span = document.createElement('div'); // div ensures grid works better than span
                    span.innerHTML = `<b>${letters[idx]})</b> ${op}`;
                    opts.appendChild(span);
                });
                mcq.appendChild(opts);
            }

            mcqContainer.appendChild(mcq);
        }

        // Re-render Math if needed
        if(window.MathJax) MathJax.typesetPromise();
    }

    function loadJSON(path) {
        fetch(path)
            .then(res => res.json())
            .then(data => renderMCQ(data))
            .catch(err => {
                console.error(err);
                alert("Error loading JSON: " + err.message);
            });
    }

    // Auto-load first item
    window.addEventListener('DOMContentLoaded', () => {
        const firstBtn = sidebar.querySelector('.json-btn');
        if (firstBtn) firstBtn.click();
    });
</script>

</body>
</html>
